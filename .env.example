# Copy to .env, edit, then `source .env`. Defaults are in infer3d/config.py.

# Everything downloaded in README step 3 lives under here.
export INFER3D_EXTERN_ROOT=$HOME/infer3d-data

# Where runs are written. Meshing intermediates are several GB per experiment.
export INFER3D_RUNS_ROOT=$PWD/runs

# Only set these if you put something somewhere other than $INFER3D_EXTERN_ROOT.
# export CO3D_DATASET_ROOT_HQ=$INFER3D_EXTERN_ROOT/co3d_processed_1080
# export RE10K_CLIPS=$INFER3D_EXTERN_ROOT/re10k_clips_test_256
# export REALCARS_ROOT=$INFER3D_EXTERN_ROOT/realcars
# export REALCARS_PSEUDO_GT=$INFER3D_EXTERN_ROOT/realcars_pseudo_gt
# export DIFFAE_ROOT=$INFER3D_EXTERN_ROOT/diffae
# export LIFTER_DIR=$INFER3D_EXTERN_ROOT/lifters
# export CATSPLAT_ROOT=$INFER3D_EXTERN_ROOT/CATSplat
# export GS2MESH_ROOT=$INFER3D_EXTERN_ROOT/gs2mesh

# wandb is imported by the eval loops but never used; leave this disabled.
export WANDB_MODE=disabled
