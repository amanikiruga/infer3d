# Copy to `.env`, edit the roots, then `source .env`.
#
# None of this is needed to CHECK the reported numbers -- `scripts/verify.sh` recomputes
# every table from result files bundled in the repository. These paths matter only when
# re-running experiments. See DATA.md for what each item is and where to get it.
#
# Defaults for everything live in infer3d/config.py; this file only overrides them.

# Parent directory holding datasets/, diffae/, stylegan3/, splatter-image/, ...
# Most paths below are derived from it, so on a standard layout this is the only edit.
export INFER3D_EXTERN_ROOT=/net/holy-isilon/ifs/rc_labs/ydu_lab/Lab/akiruga

# Where THIS repository writes runs and eval output. Must be writable. `general.prefix`
# is resolved relative to it. Stage B intermediates run to several GB -- prefer scratch.
# export INFER3D_RUNS_ROOT=/scratch/$USER/infer3d-runs

# --- datasets ---------------------------------------------------------------
export CO3D_DATASET_ROOT=$INFER3D_EXTERN_ROOT/datasets/co3d_processed
export SHAPENET_NMR_ROOT=$INFER3D_EXTERN_ROOT/datasets/srn_nmr_classes
export SHAPENET_NMR_SE3_ROOT=$INFER3D_EXTERN_ROOT/datasets/srn_nmr_se3
# export CO3D_DATASET_ROOT_HQ=$INFER3D_EXTERN_ROOT/datasets/co3d_processed_1080
# export SHAPENET_CORE_V2=$INFER3D_EXTERN_ROOT/datasets/ShapeNetCore.v2   # Chamfer GT meshes
# export RE10K_CLIPS=$INFER3D_EXTERN_ROOT/datasets/re10k_clips_test_256   # Table 3
# export REALCARS_ROOT=$INFER3D_EXTERN_ROOT/datasets/realcars/HQ339       # Table 5

# --- frozen 2D priors (cloned repos, not pip-installable) -------------------
export DIFFAE_ROOT=$INFER3D_EXTERN_ROOT/diffae
export STYLEGAN3_ROOT=$INFER3D_EXTERN_ROOT/stylegan3

# --- frozen 3D lifters ------------------------------------------------------
# Splatter-Image checkpoints + the cached per-object eval CSVs. Read-only is fine.
export SPLATTER_REPO_ROOT=$INFER3D_EXTERN_ROOT/splatter-image
# CATSplat, the RE10K lifter (Table 3)
# export CATSPLAT_ROOT=$INFER3D_EXTERN_ROOT/iccv25_CATSplat
# export CATSPLAT_CKPT=$CATSPLAT_ROOT/checkpoints/CATSplat.pth

# --- Table 5 extras ---------------------------------------------------------
# export GS2MESH_ROOT=$INFER3D_EXTERN_ROOT/gs2mesh
# export DINO_PCA_BASIS=$INFER3D_EXTERN_ROOT/datasets/srn_cars/cars_extras/dino_pca_basis.pt

# --- rebuttal baseline comparisons (only to re-run tools/rebuttal/baselines) -
# export BASELINES_ROOT=$INFER3D_EXTERN_ROOT/rebuttal_infer3d_baselines
# export REBUTTAL_ASSETS=$INFER3D_EXTERN_ROOT/splatter-image-rebuttal/rebuttal

# --- behaviour --------------------------------------------------------------
# A wandb-0.22 bug crashes the ICP eval stage; keep this disabled.
export WANDB_MODE=disabled
# How the eval rebuilds optimized splats: "aligned" (default) or "paper".
# This moves CO3D OOD PSNR by ~1 dB -- see REPRODUCTION.md.
# export INFER3D_OURS_REGEN=aligned
